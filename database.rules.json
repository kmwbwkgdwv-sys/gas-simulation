{
  "rules": {
    ".read": false,
    ".write": false,
    "mantan": {
      "saves": {
        "$code": {
          ".read": "$code.matches(/^GS-[A-Z0-9]{4}-[A-Z0-9]{4}$/)",
          ".write": "$code.matches(/^GS-[A-Z0-9]{4}-[A-Z0-9]{4}$/)",
          ".validate": "newData.hasChildren(['j', 't'])",
          "j": { ".validate": "newData.isString() && newData.val().length < 4000" },
          "t": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      },
      "rooms": {
        "$room": {
          ".read": "$room.matches(/^[A-Z0-9]{5}$/)",
          "p": {
            "$peer": {
              ".write": "$room.matches(/^[A-Z0-9]{5}$/) && $peer.matches(/^p[a-z0-9]{1,12}$/)",
              ".validate": "newData.isString() && newData.val().length < 300"
            }
          },
          "w": {
            ".write": "$room.matches(/^[A-Z0-9]{5}$/)",
            ".validate": "newData.isString() && newData.val().length < 6000"
          },
          "ev": {
            "$ev": {
              ".write": "$room.matches(/^[A-Z0-9]{5}$/)",
              ".validate": "newData.hasChildren(['d', 'f', 'ts'])",
              "d": { ".validate": "newData.isString() && newData.val().length < 400" },
              "f": { ".validate": "newData.isString() && newData.val().length < 16" },
              "ts": { ".validate": "newData.val() == now" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
